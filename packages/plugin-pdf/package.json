{
  "engines": {
    "mdview": ">=1.0.0"
  },
  "version": "1.0.0",
  "activationEvents": [
    "onFileType:pdf"
  ],
  "name": "@mdview/plugin-pdf",
  "dependencies": {
    "@mdview/plugin-api": "file:../plugin-api"
  },
