{
  "engines": {
    "mdview": ">=1.0.0"
  },
  "version": "1.0.0",
  "activationEvents": [
    "onFileType:png",
    "onFileType:jpg",
    "onFileType:jpeg",
    "onFileType:gif",
    "onFileType:bmp",
    "onFileType:svg",
    "onFileType:webp"
  ],
  "name": "@mdview/plugin-images",
  "dependencies": {
    "@mdview/plugin-api": "file:../plugin-api"
  },
  "displayName": "Image Viewer",
  "contributes": {
    "fileTypes": [
      {
        "extensions": [
          "png",
          "jpg",
          "jpeg",
          "gif",
          "bmp",
          "svg",
          "webp",
          "ico",
          "tiff",
          "tif",
          "avif"
        ],
        "name": "Image"
      }
    ],
    "name": "image-viewer"
  },
  "license": "MIT",
  "description": "Image viewer with fit-to-width/height",
  "main": "src/index.tsx"
}