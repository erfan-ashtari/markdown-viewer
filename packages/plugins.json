[
  {
    "name": "plugin-pdf",
    "package": "@mdview/plugin-pdf",
    "entry": "../plugin-pdf/src/index.tsx",
    "version": "1.0.0",
    "description": "PDF viewer using Chromium native renderer",
    "displayName": "PDF Viewer",
    "activationEvents": [
      "onFileType:pdf"
    ],
    "contributes": {
      "fileTypes": [
        {
          "extensions": [
            "pdf"
          ],
          "name": "PDF Document"
        }
      ]
    }
  },
  {
    "name": "plugin-images",
    "package": "@mdview/plugin-images",
    "entry": "../plugin-images/src/index.tsx",
    "version": "1.0.0",
    "description": "Image viewer with fit-to-width/height",
    "displayName": "Image Viewer",
    "activationEvents": [
      "onFileType:png",
      "onFileType:jpg",
      "onFileType:jpeg",
      "onFileType:gif",
      "onFileType:bmp",
      "onFileType:svg",
      "onFileType:webp"
    ],
    "contributes": {
      "fileTypes": [
        {
          "extensions": [
            "png",
            "jpg",
            "jpeg",
            "gif",
            "bmp",
            "svg",
            "webp",
            "ico",
            "tiff",
            "tif",
            "avif"
          ],
          "name": "Image"
        }
      ]
    }
  },
  {
    "name": "plugin-editor",
    "package": "@mdview/plugin-editor",
    "entry": "../plugin-editor/src/index.tsx",
    "version": "1.0.0",
    "description": "Text editor with save functionality",
    "displayName": "Text Editor",
    "activationEvents": [
      "onStartup"
    ],
    "contributes": {
      "slots": [
        {
          "order": 50,
          "slot": "header-right",
          "id": "editor-toggle"
        }
      ]
    }
  }
]